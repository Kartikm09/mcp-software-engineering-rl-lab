          "path": "dedupe.go",
          "text": "package dedupe\n\nfunc UniqueWithStats(values []string) ([]string, int) {\n\tresult := make([]string, 0, len(values))\n\tcomparisons := 0\n\tfor _, value := range values {\n\t\tduplicate := false\n\t\tfor _, existing := range result {\n\t\t\tcomparisons++\n\t\t\tif existing == value {\n\t\t\t\tduplicate = true\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t\tif !duplicate {\n\t\t\tresult = append(result, value)\n\t\t}\n\t}\n\treturn result, comparisons\n}\n\n"
