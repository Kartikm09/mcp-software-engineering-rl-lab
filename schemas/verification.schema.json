{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mcp-rl/verification.schema.json",
  "title": "Deterministic patch verification result",
  "type": "object",
  "additionalProperties": false,
  "required": ["classification", "accepted", "changed_files", "public_results", "held_out_results", "benchmark_results", "errors", "candidate_workspace_exclusions_verified", "duration_ms"],
  "properties": {
    "classification": {"enum": ["accepted", "compile_error", "runtime_error", "test_failure", "hidden_test_failure", "contract_violation", "performance_regression", "incorrect_tool_use", "missing_evidence", "incomplete_task", "malformed_patch"]},
    "accepted": {"type": "boolean"},
    "changed_files": {"type": "array", "items": {"type": "string"}},
    "public_results": {"$ref": "#/$defs/processes"},
    "held_out_results": {"$ref": "#/$defs/processes"},
    "benchmark_results": {"$ref": "#/$defs/processes"},
    "errors": {"type": "array", "items": {"type": "string"}},
    "candidate_workspace_exclusions_verified": {"type": "boolean"},
    "duration_ms": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "processes": {"type": "array", "items": {"$ref": "#/$defs/process"}},
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "exit_code", "duration_ms", "stdout", "stderr", "timed_out", "output_truncated"],
      "properties": {
        "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "exit_code": {"type": ["integer", "null"]},
        "duration_ms": {"type": "integer", "minimum": 0},
        "stdout": {"type": "string"},
        "stderr": {"type": "string"},
        "timed_out": {"type": "boolean"},
        "output_truncated": {"type": "boolean"}
      }
    }
  }
}
