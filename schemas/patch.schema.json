{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mcp-rl/patch.schema.json",
  "title": "Candidate patch evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "sha256", "changed_files", "byte_size"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "changed_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "byte_size": {"type": "integer", "minimum": 1, "maximum": 1000000}
  }
}
