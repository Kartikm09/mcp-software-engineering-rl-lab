{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mcp-rl/episode.schema.json",
  "title": "Coding-agent evaluation episode",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "episode_id", "task_id", "initial_prompt", "available_servers", "tool_trace", "patch_sha256", "final_explanation", "verification", "reward", "started_at", "completed_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "episode_id": {"type": "string", "pattern": "^episode-[a-f0-9]{12}$"},
    "task_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "initial_prompt": {"type": "string", "minLength": 20},
    "available_servers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "tool_trace": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "patch_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "final_explanation": {"type": "string", "minLength": 20},
    "verification": {"type": "object"},
    "reward": {"type": "object"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"}
  }
}
